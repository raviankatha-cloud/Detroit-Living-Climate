# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Database (Supabase) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── SmartBuildings / ecobee (preferred) ───────────────────────────────────────
# Get these from ecobee SmartBuildings portal — NOT the residential developer app.
# The app uses SmartBuildings automatically when these are set.
SMARTBUILDINGS_CLIENT_ID=
SMARTBUILDINGS_CLIENT_SECRET=
SMARTBUILDINGS_API_BASE=https://api.sb.ecobee.com
SMARTBUILDINGS_API_AUDIENCE=https://api.sb.ecobee.com
SMARTBUILDINGS_TOKEN_URL=https://api.sb.ecobee.com/api/v2/token

# ── Consumer ecobee (fallback, residential API) ───────────────────────────────
# Only needed if NOT using SmartBuildings. Leave blank when SmartBuildings is set.
ECOBEE_APP_KEY=
ECOBEE_SCOPE=smartWrite
ECOBEE_REDIRECT_URI=https://climate.detroitliving.com/api/ecobee/callback
ECOBEE_API_BASE_URL=https://api.ecobee.com
ECOBEE_SYNC_SECRET=
ECOBEE_REFRESH_TOKEN=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://climate.detroitliving.com

# ── Notifications ─────────────────────────────────────────────────────────────
EMAIL_ALERT_FROM=
EMAIL_ALERT_WEBHOOK_URL=
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_WEBHOOK_URL=
